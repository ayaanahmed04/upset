# Python virtual environment
.venv/

# Python cache files
__pycache__/
*.py[cod]

# Environment variables and secrets
.env
.env.*
!.env.example

# Jupyter temporary files
.ipynb_checkpoints/

# macOS
.DS_Store

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage files
.coverage
htmlcov/

# Python build artifacts
build/
dist/
*.egg-info/

# Node / Next.js
node_modules/
.next/
out/

# Logs
*.log

# Local datasets
data/raw/*
data/processed/*

# Keep the empty data directory structure in Git
!data/raw/.gitkeep
!data/processed/.gitkeep